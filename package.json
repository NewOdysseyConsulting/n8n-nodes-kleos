{
	"name": "n8n-nodes-kleos",
	"version": "0.1.0",
	"description": "n8n community node for Kleos (getkleos.ai): businesses, posts, articles, review queue, leads, results, AI visibility, campaigns and suggestions, plus a trigger for Kleos webhooks. Usable as an AI agent tool.",
	"license": "MIT",
	"homepage": "https://getkleos.ai/integrations/n8n",
	"keywords": [
		"n8n-community-node-package",
		"kleos",
		"marketing",
		"content",
		"seo",
		"linkedin",
		"ai-visibility",
		"webhooks"
	],
	"author": {
		"name": "Kleos (New Odyssey)",
		"email": "support@getkleos.ai"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/NewOdysseyConsulting/n8n-nodes-kleos.git"
	},
	"bugs": {
		"url": "https://github.com/NewOdysseyConsulting/n8n-nodes-kleos/issues"
	},
	"engines": {
		"node": ">=20.15"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"typecheck": "tsc --noEmit",
		"test": "tsx --test test/*.test.mts",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/KleosApi.credentials.js",
			"dist/credentials/KleosLeadTrackingApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Kleos/Kleos.node.js",
			"dist/nodes/KleosTrigger/KleosTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.56.2",
		"@types/node": "24.19.2",
		"eslint": "9.39.4",
		"n8n-workflow": "2.16.0",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"tsx": "4.23.15",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
